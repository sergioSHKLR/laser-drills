     4
    ],
    "parTime": 3.0,
    "timeout": 10,
    "brief": "From the beep: 2 to the body -0."
   },
   {
    "name": "3. Head shots",
    "target": "idpa-threat",
    "shots": 2,
    "startDelay": [
     2,
     4
    ],
    "parTime": 4.0,
    "timeout": 10,
    "brief": "2 to the head -0 circle; rest of the head box is -1."
   },
   {
    "name": "4. Hard cover: left",
    "target": "idpa-hc-left",
    "shots": 2,
    "startDelay": [
     2,
     4
    ],
    "parTime": 4.0,
    "timeout": 10,
    "brief": "Left half is behind hard cover. 2 on the exposed -0."
   },
   {
    "name": "5. Hard cover: lower",
