    "shots": 2,
    "startDelay": [
     2,
     4
    ],
    "parTime": 4.0,
    "timeout": 10,
    "brief": "Lower body covered. 2 on the upper -0 or head."
   },
   {
    "name": "6. Hard cover: diagonal",
    "target": "idpa-hc-diagonal",
    "shots": 2,
    "startDelay": [
     2,
     4
    ],
    "parTime": 4.5,
    "timeout": 10,
    "brief": "Diagonal cover. 2 on the exposed -0 edge."
   },
   {
    "name": "7. Threat + non-threat",
    "target": "idpa-nt-pair",
    "shots": 2,
    "startDelay": [
     2,
     4
    ],
    "parTime": 4.0,
    "timeout": 10,
    "brief": "2 on the RIGHT threat only. Hands = non-threat (+5 s)."
   },
   {
    "name": "8. Multiple threats",
